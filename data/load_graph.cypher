CREATE CONSTRAINT IF NOT EXISTS FOR (c:Candidate) REQUIRE c.candidate_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (s:Skill) REQUIRE s.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (j:Job) REQUIRE j.job_id IS UNIQUE;
MERGE (j:Job {job_id:'J001'}) SET j.title='Data Scientist', j.department='Analytics';
MATCH (j:Job {job_id:'J001'}) MERGE (s:Skill {name:'Python'}) MERGE (j)-[:REQUIRES]->(s);
MATCH (j:Job {job_id:'J001'}) MERGE (s:Skill {name:'Machine Learning'}) MERGE (j)-[:REQUIRES]->(s);
